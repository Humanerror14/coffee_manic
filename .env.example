# ── Coffee Manic — environment example ─────────────────────────────
# Salin file ini menjadi .env dan sesuaikan nilainya.
#   cp .env.example .env
# Jangan commit file .env.

# Flask
FLASK_ENV=development
# Untuk produksi, gunakan nilai acak terpisah dengan panjang minimal 32 karakter.
SECRET_KEY=change-me-to-a-random-secret
JWT_SECRET_KEY=change-me-to-another-random-secret

# Supabase Project Config
SUPABASE_PROJECT_ID=zofyjgrsfjcburhuxvdz
SUPABASE_URL=https://zofyjgrsfjcburhuxvdz.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_P1QyUJhnNA4_l_TgOEEWkg_JC09z0tl
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6InpvZnlqZ3JzZmpjYnVyaHV4dmR6Iiwicm9sZSI6ImFub24iLCJpYXQiOjE3OTQ2NTkzMTksImV4cCI6MjExMDIzNTMxOX0.usS9STSGo2b9FM957lAI7AkB0ntKMht7IIxESLlWLms

# Database — Supabase PostgreSQL
# Ganti [YOUR-DATABASE-PASSWORD] dengan password database Supabase Anda:
# Opsi 1: Connection Pooler (Port 6543, direkomendasikan untuk stabilitas jaringan):
DATABASE_URL=postgresql+psycopg://postgres.zofyjgrsfjcburhuxvdz:[YOUR-DATABASE-PASSWORD]@aws-0-ap-northeast-2.pooler.supabase.com:6543/postgres?sslmode=require

# Opsi 2: Direct Connection (Port 5432):
# DATABASE_URL=postgresql+psycopg://postgres:[YOUR-DATABASE-PASSWORD]@db.zofyjgrsfjcburhuxvdz.supabase.co:5432/postgres?sslmode=require

# Opsi 3: SQLite Lokal (Otomatis dipakai jika DATABASE_URL tidak diisi atau database remote tidak terjangkau):
# DATABASE_URL=sqlite:///coffee_manic.db

# CORS (asal frontend dev server)
CORS_ORIGINS=http://localhost:5173

# Rate limiter API: jumlah request per 60 detik per IP (default 60).
# Penyimpanan lokal per instance aplikasi/proses; lihat backend/README.md.
RATE_LIMIT_PER_MINUTE=60

# Seed admin (dev only — ganti sebelum produksi)
ADMIN_EMAIL=admin@coffeemanic.local
ADMIN_PASSWORD=change-me-admin
